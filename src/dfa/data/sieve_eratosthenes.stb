    trigger     : step;
    guard       : (candidate = 25);
    action      : { primeCount := primeCount + p25; candidate := 26; }
  }

  // --- CollectA/CollectB -> Done ---
  transition t_cA_done {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.Done;
    trigger     : step;
    guard       : (candidate > 25);
    action      : {}
  }

  transition t_cB_done {
    source      : SieveOfEratosthenes.CollectB;
    destination : SieveOfEratosthenes.Done;
    trigger     : step;
    guard       : (candidate > 25);
    action      : {}
  }
}
