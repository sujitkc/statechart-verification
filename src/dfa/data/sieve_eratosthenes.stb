    destination : SieveOfEratosthenes.CollectA;
    trigger     : step;
    guard       : (candidate = 23) && (p23 = 1);
    action      : { candidate := 2; primeCount := 0; }
  }

  // ================================================================
  //  COLLECT RESULTS: CollectA -> CollectB -> CollectA -> ...
  //  Count primes by adding each flag to primeCount.
  // ================================================================

  // --- CollectA -> CollectB ---
  transition t_cAB_2 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 2);
    action      : { primeCount := primeCount + p2; candidate := 3; }
  }

  transition t_cAB_4 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 4);
    action      : { primeCount := primeCount + p4; candidate := 5; }
  }

  transition t_cAB_6 {
    source      : SieveOfEratosthenes.CollectA;
