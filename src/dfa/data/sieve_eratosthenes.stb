    trigger     : step;
    guard       : (candidate = 6);
    action      : { primeCount := primeCount + p6; candidate := 7; }
  }

  transition t_cAB_8 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 8);
    action      : { primeCount := primeCount + p8; candidate := 9; }
  }

  transition t_cAB_10 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 10);
    action      : { primeCount := primeCount + p10; candidate := 11; }
  }

  transition t_cAB_12 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 12);
    action      : { primeCount := primeCount + p12; candidate := 13; }
  }

  transition t_cAB_14 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 14);
    action      : { primeCount := primeCount + p14; candidate := 15; }
  }

  transition t_cAB_16 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 16);
    action      : { primeCount := primeCount + p16; candidate := 17; }
  }

  transition t_cAB_18 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 18);
    action      : { primeCount := primeCount + p18; candidate := 19; }
  }

  transition t_cAB_20 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 20);
    action      : { primeCount := primeCount + p20; candidate := 21; }
  }

  transition t_cAB_22 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 22);
    action      : { primeCount := primeCount + p22; candidate := 23; }
  }

  transition t_cAB_24 {
    source      : SieveOfEratosthenes.CollectA;
    destination : SieveOfEratosthenes.CollectB;
    trigger     : step;
    guard       : (candidate = 24);
    action      : { primeCount := primeCount + p24; candidate := 25; }
  }

  // --- CollectB -> CollectA ---
  transition t_cBA_3 {
    source      : SieveOfEratosthenes.CollectB;
    destination : SieveOfEratosthenes.CollectA;
    trigger     : step;
    guard       : (candidate = 3);
    action      : { primeCount := primeCount + p3; candidate := 4; }
  }

  transition t_cBA_5 {
    source      : SieveOfEratosthenes.CollectB;
    destination : SieveOfEratosthenes.CollectA;
    trigger     : step;
    guard       : (candidate = 5);
    action      : { primeCount := primeCount + p5; candidate := 6; }
  }

  transition t_cBA_7 {
    source      : SieveOfEratosthenes.CollectB;
    destination : SieveOfEratosthenes.CollectA;
    trigger     : step;
    guard       : (candidate = 7);
    action      : { primeCount := primeCount + p7; candidate := 8; }
  }

  transition t_cBA_9 {
    source      : SieveOfEratosthenes.CollectB;
    destination : SieveOfEratosthenes.CollectA;
    trigger     : step;
    guard       : (candidate = 9);
    action      : { primeCount := primeCount + p9; candidate := 10; }
  }

  transition t_cBA_11 {
    source      : SieveOfEratosthenes.CollectB;
