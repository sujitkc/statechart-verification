// TVSetPlus-8: Models a TV with power control and 10 parallel features

statechart TVSetPlus8 {
  
  types {}
  
  events {
    on;
    off;
    txt;
    mute;
    sound;
    in;
    out;
    f1;
    f2;
    f3;
    f4;
    f5;
    f6;
    f7;
    f8;
  }
  
  a : int : local;
  b : int : local;
  c : int : local;
  d : int : local;
  
  entry : {
    a := 0;
    b := 0;
    c := 0;
    d := 1;
  }
  exit  : {}
  
  functions {
    input<||>() : int;
  }
  
  // Top-level states: WAITING and WORKING
  state WAITING {
    entry : {
      b := 0;
    }
    exit  : {
      b := 1;
    }
    
    // POWER subsystem (part of WAITING)
    state STANDBY {
      entry : {
        d := 1;
      }
      exit  : {
        d := d + 1;
      }
    }
    
    state DISCONNECTED {
      entry : {
        d := 0;
      }
      exit  : {
        d := 1;
      }
    }
    
    transition t_standby_to_disconnected {
      source      : TVSetPlus8.WAITING.STANDBY;
      destination : TVSetPlus8.WAITING.DISCONNECTED;
      trigger     : out;
      guard       : true;
      action      : {
        a := a - 1;
      }
    }
    
    transition t_disconnected_to_standby {
      source      : TVSetPlus8.WAITING.DISCONNECTED;
      destination : TVSetPlus8.WAITING.STANDBY;
      trigger     : in;
      guard       : true;
      action      : {
        a := a + 1;
      }
    }
  }
  
  shell WORKING {
    entry : {
      b := 2;
      c := 0;
    }
    exit  : {
      b := 0;
      c := 0;
    }
    
    // Region 1: IMAGE control
    state IMAGE {
        entry : {
          c := c + 1;
        }
        exit  : {
          c := c - 1;
        }
        
        state PICTURE {
          entry : {
            d := d + 1;
          }
          exit  : {
            d := d - 1;
          }
        }
        
        state TEXT {
          entry : {
            d := d + 2;
          }
          exit  : {
            d := d - 2;
          }
        }
        
        transition t_picture_to_text {
          source      : TVSetPlus8.WORKING.IMAGE.PICTURE;
          destination : TVSetPlus8.WORKING.IMAGE.TEXT;
          trigger     : txt;
          guard       : true;
          action      : {
            b := b + 1;
          }
        }
        
        transition t_text_to_picture {
          source      : TVSetPlus8.WORKING.IMAGE.TEXT;
          destination : TVSetPlus8.WORKING.IMAGE.PICTURE;
          trigger     : txt;
          guard       : true;
          action      : {
            b := b - 1;
          }
        }
      }
      
      // Region 2: SOUND control
      state SOUND {
        entry : {
          c := c + 1;
        }
        exit  : {
          c := c - 1;
        }
        
        state ON {
          entry : {
            d := d * 2;
          }
          exit  : {
            d := d + 1;
          }
        }
        
        state OFF {
          entry : {
            d := d - 2;
          }
          exit  : {
            d := d + 2;
          }
        }
        
        transition t_sound_on_to_off {
          source      : TVSetPlus8.WORKING.SOUND.ON;
          destination : TVSetPlus8.WORKING.SOUND.OFF;
          trigger     : mute;
          guard       : true;
          action      : {
            d := d - 1;
          }
        }
        
        transition t_sound_off_to_on {
          source      : TVSetPlus8.WORKING.SOUND.OFF;
          destination : TVSetPlus8.WORKING.SOUND.ON;
          trigger     : sound;
          guard       : true;
          action      : {
            d := d + 1;
          }
        }
      }
      
      // Region 3: Feature F1
      state F1 {
        entry : {
          c := c + 1;
        }
        exit  : {
          c := c - 1;
        }
        
        state F1_ON {
          entry : {}
          exit  : {
            a := a - 1;
          }
        }
        
        state F1_OFF {
          entry : {}
          exit  : {
            a := a + 1;
          }
        }
        
        transition t_f1_on_to_off {
          source      : TVSetPlus8.WORKING.F1.F1_ON;
          destination : TVSetPlus8.WORKING.F1.F1_OFF;
          trigger     : f1;
          guard       : true;
          action      : {
            a := a + 1;
          }
        }
        
        transition t_f1_off_to_on {
          source      : TVSetPlus8.WORKING.F1.F1_OFF;
          destination : TVSetPlus8.WORKING.F1.F1_ON;
          trigger     : f1;
          guard       : true;
          action      : {
            a := a - 1;
          }
        }
      }
      
      // Region 4: Feature F2
      state F2 {
        entry : {
          c := c + 2;
        }
        exit  : {
          c := c - 2;
        }
        
        state F2_ON {
          entry : {}
          exit  : {
            b := b - 1;
          }
        }
        
        state F2_OFF {
          entry : {}
          exit  : {
            b := b + 1;
          }
        }
        
        transition t_f2_on_to_off {
          source      : TVSetPlus8.WORKING.F2.F2_ON;
          destination : TVSetPlus8.WORKING.F2.F2_OFF;
          trigger     : f2;
          guard       : true;
          action      : {
            b := b + 2;
          }
        }
        
        transition t_f2_off_to_on {
          source      : TVSetPlus8.WORKING.F2.F2_OFF;
          destination : TVSetPlus8.WORKING.F2.F2_ON;
          trigger     : f2;
          guard       : true;
          action      : {
            b := b - 2;
          }
        }
      }
      
      // Region 5: Feature F3
      state F3 {
        entry : {}
        exit  : {
          c := c + 1;
        }
        
        state F3_ON {
          entry : {}
          exit  : {
            d := d - 3;
          }
        }
        
        state F3_OFF {
          entry : {}
          exit  : {
            d := d + 3;
          }
        }
        
        transition t_f3_on_to_off {
          source      : TVSetPlus8.WORKING.F3.F3_ON;
          destination : TVSetPlus8.WORKING.F3.F3_OFF;
          trigger     : f3;
          guard       : true;
          action      : {
            d := d + 3;
          }
        }
        
        transition t_f3_off_to_on {
          source      : TVSetPlus8.WORKING.F3.F3_OFF;
          destination : TVSetPlus8.WORKING.F3.F3_ON;
          trigger     : f3;
          guard       : true;
          action      : {
            d := d - 3;
          }
        }
      }
      
      // Region 6: Feature F4
      state F4 {
        entry : {}
        exit  : {
          a := a + 1;
        }
        
        state F4_ON {
          entry : {}
          exit  : {
            c := c - 4;
          }
        }
        
        state F4_OFF {
          entry : {}
          exit  : {
            c := c + 4;
          }
        }
        
        transition t_f4_on_to_off {
          source      : TVSetPlus8.WORKING.F4.F4_ON;
          destination : TVSetPlus8.WORKING.F4.F4_OFF;
          trigger     : f4;
          guard       : true;
          action      : {
            c := c * 2;
          }
        }
        
        transition t_f4_off_to_on {
          source      : TVSetPlus8.WORKING.F4.F4_OFF;
          destination : TVSetPlus8.WORKING.F4.F4_ON;
          trigger     : f4;
          guard       : true;
          action      : {
            c := c + 4;
          }
        }
      }
      
      // Region 7: Feature F5
      state F5 {
        entry : {}
        exit  : {
          b := b - 1;
        }
        
        state F5_ON {
          entry : {}
          exit  : {
            a := a - 5;
          }
        }
        
        state F5_OFF {
          entry : {}
          exit  : {
            a := a + 5;
          }
        }
        
        transition t_f5_on_to_off {
          source      : TVSetPlus8.WORKING.F5.F5_ON;
          destination : TVSetPlus8.WORKING.F5.F5_OFF;
          trigger     : f5;
          guard       : true;
          action      : {
            a := a + 5;
          }
        }
        
        transition t_f5_off_to_on {
          source      : TVSetPlus8.WORKING.F5.F5_OFF;
          destination : TVSetPlus8.WORKING.F5.F5_ON;
          trigger     : f5;
          guard       : true;
          action      : {
            a := a - 5;
          }
        }
      }
      
      // Region 8: Feature F6
      state F6 {
        entry : {}
        exit  : {
          d := d + 1;
        }
        
        state F6_ON {
          entry : {}
          exit  : {
            b := b + 6;
          }
        }
        
        state F6_OFF {
          entry : {}
          exit  : {
            b := b - 6;
          }
        }
        
        transition t_f6_on_to_off {
          source      : TVSetPlus8.WORKING.F6.F6_ON;
          destination : TVSetPlus8.WORKING.F6.F6_OFF;
          trigger     : f6;
          guard       : true;
          action      : {
            b := b - 3;
          }
        }
        
        transition t_f6_off_to_on {
          source      : TVSetPlus8.WORKING.F6.F6_OFF;
          destination : TVSetPlus8.WORKING.F6.F6_ON;
          trigger     : f6;
          guard       : true;
          action      : {
            b := b + 3;
          }
        }
      }
      
      // Region 9: Feature F7
      state F7 {
        entry : {}
        exit  : {
          c := c - 1;
        }
        
        state F7_ON {
          entry : {}
          exit  : {
            d := d + 7;
          }
        }
        
        state F7_OFF {
          entry : {}
          exit  : {
            d := d - 7;
          }
        }
        
        transition t_f7_on_to_off {
          source      : TVSetPlus8.WORKING.F7.F7_ON;
          destination : TVSetPlus8.WORKING.F7.F7_OFF;
          trigger     : f7;
          guard       : true;
          action      : {
            d := d + 7;
          }
        }
        
        transition t_f7_off_to_on {
          source      : TVSetPlus8.WORKING.F7.F7_OFF;
          destination : TVSetPlus8.WORKING.F7.F7_ON;
          trigger     : f7;
          guard       : true;
          action      : {
            d := d - 7;
          }
        }
      }
      
      // Region 10: Feature F8
      state F8 {
        entry : {}
        exit  : {
          a := a + 2;
        }
        
        state F8_ON {
          entry : {}
          exit  : {
            c := c + 8;
          }
        }
        
        state F8_OFF {
          entry : {}
          exit  : {
            c := c - 8;
          }
        }
        
        transition t_f8_on_to_off {
          source      : TVSetPlus8.WORKING.F8.F8_ON;
          destination : TVSetPlus8.WORKING.F8.F8_OFF;
          trigger     : f8;
          guard       : true;
          action      : {
            c := c + 8;
          }
        }
        
        transition t_f8_off_to_on {
          source      : TVSetPlus8.WORKING.F8.F8_OFF;
          destination : TVSetPlus8.WORKING.F8.F8_ON;
          trigger     : f8;
          guard       : true;
          action      : {
            c := c - 8;
          }
        }
      }
    }
  
  // Main transitions between WAITING and WORKING
  // Power ON: from WAITING.STANDBY to WORKING (enters all default substates)
  transition t_power_on {
    source      : TVSetPlus8.WAITING.STANDBY;
    destination : TVSetPlus8.WORKING;
    trigger     : on;
    guard       : true;
    action      : {
      a := a + 1;
      b := 1;
    }
  }
  
  // Power OFF: from WORKING back to WAITING.STANDBY
  transition t_power_off {
    source      : TVSetPlus8.WORKING;
    destination : TVSetPlus8.WAITING.STANDBY;
    trigger     : off;
    guard       : true;
    action      : {
      a := a - 1;
      b := 0;
    }
  }
}
